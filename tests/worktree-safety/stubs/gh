#!/usr/bin/env bash
# Stateful `gh` stand-in for the worktree-safety corpus. Answers the two
# `gh pr list` shapes the classifier uses from $CORPUS_DIR/prs.tsv
# (branch, state, number, head, cross-repository) after applying the same
# filter the real -q expression applies.
set -euo pipefail
[ -e "$CORPUS_DIR/forge-down" ] && exit 1
[ "${1:-}" = pr ] && [ "${2:-}" = list ] || exit 1
head_branch=""
while [ $# -gt 0 ]; do
  case "$1" in --head) head_branch="$2"; shift 2 ;; *) shift ;; esac
done
prs="$CORPUS_DIR/prs.tsv"
[ -f "$prs" ] || exit 0
if [ -z "$head_branch" ]; then
  awk -F'\t' -v OFS='\t' '$5 != "true" { print $1, $2, $3, $4 }' "$prs"
else
  awk -F'\t' -v b="$head_branch" '$1 == b && $5 != "true" && ($3 + 0) > best { best = $3 + 0; line = $2 " " $3 " " $4 } END { if (line != "") print line }' "$prs"
fi
