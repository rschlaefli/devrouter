#!/usr/bin/env bash
# Stateful `gh` stand-in for the worktree-safety corpus. Answers `gh pr list`
# from $CORPUS_DIR/prs.tsv (branch, state, number, head, cross-repository).
# With `-q`, it applies the same filter as the skill's jq expression; without
# it, it prints the JSON listing that devrouter parses itself.
set -euo pipefail
[ -e "$CORPUS_DIR/forge-down" ] && exit 1
[ "${1:-}" = pr ] && [ "${2:-}" = list ] || exit 1
head_branch=""; query=0
while [ $# -gt 0 ]; do
  case "$1" in
    --head) head_branch="$2"; shift 2 ;;
    -q) query=1; shift 2 ;;
    *) shift ;;
  esac
done
prs="$CORPUS_DIR/prs.tsv"
if [ "$query" -eq 0 ]; then
  python3 - "$prs" <<'PY'
import json, os, sys
out = []
if os.path.exists(sys.argv[1]):
    for line in open(sys.argv[1], encoding="utf-8"):
        name, state, number, head, cross = line.rstrip("\n").split("\t")
        out.append({
            "number": int(number),
            "headRefName": name,
            "headRefOid": head,
            "state": state,
            "isCrossRepository": cross == "true",
        })
print(json.dumps(out))
PY
  exit 0
fi
[ -f "$prs" ] || exit 0
if [ -z "$head_branch" ]; then
  awk -F'\t' -v OFS='\t' '$5 != "true" { print $1, $2, $3, $4 }' "$prs"
else
  awk -F'\t' -v b="$head_branch" '$1 == b && $5 != "true" && ($3 + 0) > best { best = $3 + 0; line = $2 " " $3 " " $4 } END { if (line != "") print line }' "$prs"
fi
